# AlphaEarth Embeddings Configuration
# Copy this file to .env.local and fill in your values

# LGND Embeddings API configuration (server-side only)
# Obtain the bearer token from the LGND Developer Portal.
LGND_EMBEDDINGS_API_KEY=your-lgnd-bearer-token
# Optional overrides; the built-in defaults target the configured QCX collection.
LGND_TENANT_ID=ten_01a0cd9a20c671b59c2cf55ee847bc66
LGND_COLLECTION_ID=col_01a0cd9a20e170daac4573a3f7200000
# Required when users provide place names instead of coordinates.
MAPBOX_ACCESS_TOKEN=your-mapbox-public-token

# Google Cloud Project ID (required for requester-pays bucket access)
GCP_PROJECT_ID=your-project-id-here

# Path to your GCP service account credentials JSON file
# This file should have Storage Object Viewer and Service Usage Consumer roles
GCP_CREDENTIALS_PATH=/path/to/your/gcp_credentials.json

# Optional: Path to the AlphaEarth index file
# Defaults to ./aef_index.csv if not specified
AEF_INDEX_PATH=./aef_index.csv
